# --- 核心 API Keys (必填) ---
DASHSCOPE_API_KEY=sk-65eca6cec95a484596a360b7a2a48b0a
BOCHA_API_KEY=sk-06c6882c815a4505846dcf4979475c99

# --- 搜索 API Keys (可选) ---
SERPER_API_KEY=b00bb7a879d2ef50643e95a9d90851450fdb786bf63b357a4241e908580daca7
TAVILY_API_KEY=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

# --- 模型配置 ---
MODEL=qwen3.6-plus
SMALL_MODEL=qwen-turbo
SUMMARY_MODEL=qwen3.6-plus
NODE_MODEL_OVERRIDES={"intent_router":"qwen-turbo","direct_responder":"qwen-turbo"}

# --- 用户/租户 ---
THREAD_ID=default
USER_ID=default_user
TENANT_ID=default_tenant

# --- 工作流 ---
MAX_ITERATIONS=3
ENABLE_MEMORY=true

# --- 记忆: 短期 ---
SHORT_TERM_TTL_SECONDS=604800
SHORT_TERM_MAX_MESSAGES=30
SHORT_TERM_SUMMARY_THRESHOLD=20
SHORT_TERM_BACKEND=postgres

# --- 记忆: 长期 ---
LONG_TERM_BACKEND=postgres
LONG_TERM_SCOPE=user
SAVE_CONVERSATION_TASK=false

# --- Checkpointer ---
CHECKPOINTER_BACKEND=auto

# --- Milvus ---
ENABLE_MILVUS=true
MEMORY_TOP_K=6
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION=mult_agent_memory

# --- 数据库连接 ---
REDIS_URL=redis://:719241@localhost:6379
POSTGRES_DSN=postgresql://root:719241@localhost:5432/mydb

# --- 搜索配置 ---
SEARCH_BACKENDS=bocha
SEARCH_FALLBACK_BACKENDS=serper,tavily
SEARCH_COUNT=4
SEARCH_TIMEOUT=15
SEARCH_FETCH_TIMEOUT=8
SEARCH_MAX_WORKERS=6
SEARCH_CACHE_ENABLED=true
SEARCH_CACHE_TTL_SECONDS=3600
SEARCH_REWRITE_ENABLED=false
SEARCH_FETCH_ENABLED=true

# --- 可选 ---
NO_COLOR=
WORKSPACE_DIR=/workspace
