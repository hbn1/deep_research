# ============================================================
# DeepResearch Multi-Agent Environment Configuration
# Copy this file to .env and fill in real values
# ============================================================

# --- App Runtime ---
APP_ENV=development
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_AUTH_KEY=change-me-local-api-key
API_AUTH_REQUIRED=false
ADMIN_API_KEY=change-me-local-admin-key
ADMIN_API_REQUIRED=false
ADMIN_API_KEY_HEADER=X-Admin-Key
API_DOCS_ENABLED=true
VITE_ENABLE_ADMIN_TOOLS=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=60
TRUSTED_PROXY_HEADERS=false
REQUEST_ID_HEADER=X-Request-ID

# --- LangSmith Observability (optional) ---
LANGSMITH_ENABLED=false
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=deepresearch-dev
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_TAGS=local,deepresearch
LANGSMITH_ENVIRONMENT=development
LANGSMITH_SAMPLE_RATE=1.0
LANGSMITH_HIDE_INPUTS=false
LANGSMITH_HIDE_OUTPUTS=false

# --- Model Provider API Keys (required) ---
DASHSCOPE_API_KEY=sk-your-dashscope-key
BOCHA_API_KEY=sk-your-bocha-key
DASHSCOPE_HTTP_BASE_URL=https://your-workspace-host/api/v1
DASHSCOPE_WEBSOCKET_BASE_URL=wss://your-workspace-host/api-ws/v1/inference
OPENAI_BASE_URL=https://your-workspace-host/compatible-mode/v1

# --- Search API Keys (optional) ---
SERPER_API_KEY=your-serper-key
TAVILY_API_KEY=tvly-your-tavily-key

# --- Model ---
MODEL=qwen-plus
SMALL_MODEL=qwen-turbo
SUMMARY_MODEL=qwen-plus
NODE_MODEL_OVERRIDES={"intent_router":"qwen-turbo","direct_responder":"qwen-turbo"}

# --- User / Tenant ---
THREAD_ID=default
USER_ID=default_user
TENANT_ID=default_tenant

# --- Workflow ---
MAX_ITERATIONS=3
ENABLE_MEMORY=true

# --- Memory: Short-term (Redis) ---
SHORT_TERM_TTL_SECONDS=604800
SHORT_TERM_MAX_MESSAGES=30
SHORT_TERM_SUMMARY_THRESHOLD=20
SHORT_TERM_BACKEND=redis

# --- Memory: Long-term ---
LONG_TERM_BACKEND=postgres
LONG_TERM_SCOPE=user
SAVE_CONVERSATION_TASK=false

# --- Checkpointer ---
CHECKPOINTER_BACKEND=auto

# --- Milvus ---
ENABLE_MILVUS=true
MEMORY_TOP_K=6
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION=mult_agent_memory

# --- RAG Uploads ---
RAG_UPLOAD_DIR=rag_uploads
RAG_MAX_UPLOAD_MB=25
RAG_MAX_TENANT_STORAGE_MB=512
RAG_ALLOWED_EXTENSIONS=.pdf,.docx
RAG_VALIDATE_FILE_SIGNATURES=true

# --- Database ---
REDIS_URL=redis://127.0.0.1:6379
POSTGRES_DSN=postgresql://user:password@127.0.0.1:5432/dbname

# --- Search ---
SEARCH_BACKENDS=bocha
SEARCH_FALLBACK_BACKENDS=tavily
SEARCH_COUNT=3
SEARCH_TIMEOUT=8
SEARCH_FETCH_TIMEOUT=4
SEARCH_MAX_WORKERS=4
SEARCH_MAX_FETCH_PAGES=3
SEARCH_CACHE_ENABLED=true
SEARCH_CACHE_TTL_SECONDS=3600
SEARCH_CACHE_MAX_ENTRIES=1024
SEARCH_REWRITE_ENABLED=false
SEARCH_FETCH_ENABLED=true
SEARCH_NODE_TIMEOUT=

# --- Optional ---
NO_COLOR=
WORKSPACE_DIR=/workspace
JSON_FORMAT=0
