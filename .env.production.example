# Copy to .env.production and replace every placeholder before deployment.

# Public entrypoint
FRONTEND_PORT=80
PUBLIC_FRONTEND_URL=https://your-domain.example
CORS_ALLOW_ORIGINS=https://your-domain.example
CLIENT_MAX_BODY_SIZE=25m

# Build mirrors. Replace with your internal artifact mirrors in production CI.
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
PIP_EXTRA_INDEX_URL=
PIP_DEFAULT_TIMEOUT=120
NODE_IMAGE=node:22-alpine
NGINX_IMAGE=nginx:1.27-alpine
NPM_CONFIG_REGISTRY=https://registry.npmmirror.com

# Application access key used only between the reverse proxy and backend.
# Do not reuse model provider API keys here.
API_AUTH_KEY=replace-with-a-long-random-app-secret
ADMIN_API_KEY=replace-with-a-different-long-random-admin-secret

# Public builds must keep this false. Set true only for a private admin build.
VITE_ENABLE_ADMIN_TOOLS=false

# LangSmith observability. Keep disabled unless you have a LangSmith workspace.
LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=deepresearch-prod
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_TAGS=production,deepresearch
LANGSMITH_ENVIRONMENT=production
LANGSMITH_SAMPLE_RATE=1.0
LANGSMITH_HIDE_INPUTS=false
LANGSMITH_HIDE_OUTPUTS=false

# Model provider keys
DASHSCOPE_API_KEY=replace-with-dashscope-key
DASHSCOPE_HTTP_BASE_URL=https://your-workspace-host/api/v1
DASHSCOPE_WEBSOCKET_BASE_URL=wss://your-workspace-host/api-ws/v1/inference
OPENAI_BASE_URL=https://your-workspace-host/compatible-mode/v1
BOCHA_API_KEY=
SERPER_API_KEY=
TAVILY_API_KEY=

# Model routing
MODEL=qwen-plus
SMALL_MODEL=qwen-turbo
SUMMARY_MODEL=qwen-plus
NODE_MODEL_OVERRIDES=

# Runtime defaults
THREAD_ID=default
USER_ID=default_user
TENANT_ID=default_tenant
MAX_ITERATIONS=3
ENABLE_MEMORY=true
SHORT_TERM_BACKEND=redis
LONG_TERM_BACKEND=postgres
LONG_TERM_SCOPE=user
CHECKPOINTER_BACKEND=auto

# RAG
RAG_MAX_UPLOAD_MB=25
RAG_MAX_TENANT_STORAGE_MB=512
RAG_ALLOWED_EXTENSIONS=.pdf,.docx
MILVUS_COLLECTION=mult_agent_memory

# Datastores
POSTGRES_USER=deepresearch
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=deepresearch
MINIO_ROOT_USER=replace-with-a-strong-minio-user
MINIO_ROOT_PASSWORD=replace-with-a-strong-minio-password

# Search
SEARCH_BACKENDS=bocha
SEARCH_FALLBACK_BACKENDS=tavily
SEARCH_COUNT=3
SEARCH_TIMEOUT=8
SEARCH_FETCH_TIMEOUT=4
SEARCH_MAX_WORKERS=4
SEARCH_MAX_FETCH_PAGES=3
SEARCH_CACHE_ENABLED=true
SEARCH_CACHE_TTL_SECONDS=3600
SEARCH_CACHE_MAX_ENTRIES=1024
SEARCH_REWRITE_ENABLED=false
SEARCH_FETCH_ENABLED=true

# Rate limit
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=60
